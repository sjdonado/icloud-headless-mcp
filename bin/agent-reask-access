#!/bin/bash
# Wrapper so the agent can re-ask Apple for access without being able to restart anything.
#
# It used to be allowed `systemctl restart agent-browser.service`, which worked but was far too big
# a hammer: it discarded the warm tabs and the warm-up, and a restart raises an approval prompt of
# its own. Re-navigating the app tabs achieves the same re-request and leaves everything standing.
set -uo pipefail
# runuser rather than sudo. This already runs as root, so it is dropping privileges, not gaining
# them, and sudo is setuid: under the endpoint's NoNewPrivileges=yes it refuses outright with
# "the no new privileges flag is set". The button led to that error page instead of working.
# icloud-mcp-host, the same environment the server runs with: the env file's own paths and CDP
# address, the worked example's defaults for the rest.
exec runuser -u agent-icloud -- /opt/agent-icloud/bin/icloud-mcp-host reask
