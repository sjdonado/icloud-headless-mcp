[Unit]
Description=Virtual display for the iCloud browser session
After=network.target

[Service]
User=agent-icloud
Group=agent-icloud
# Chromium must run headed: Apple binds the iCloud session to the user agent, and the
# headless build reports HeadlessChrome, which invalidates the session on the next launch.
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x900x24
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
