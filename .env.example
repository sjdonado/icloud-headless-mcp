# The whole configuration is the two lines below. Everything else has a default.
#
# ICLOUD_APP_PASSWORD is an app-specific password from account.apple.com, under Sign-In and
# Security, App-Specific Passwords. It is revocable there without touching anything else. Never
# put the primary Apple password here.
ICLOUD_APPLE_ID=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Required only on a host whose clock runs UTC (a typical VPS): the owner's IANA zone. A laptop
# uses its own zone. A wrong zone moves a reminder by hours and nothing errors.
# AGENT_TZ=Europe/Amsterdam

# Optional:
# AGENT_DEFAULT_CALENDAR=Personal  where an event goes when the caller names no calendar. Set it:
#                                  the fallback is the first calendar, often a shared one.
# ICLOUD_STATE=~/.icloud-mcp       browser profile, cookie jar, locks, and every other state path.
# DRIVE_LIBRARIES='[{"name": "Example App Exports", "kind": "folder", "dest": "example-app"}]'
#                                  iCloud Drive app folders to pull (JSON, single-quoted). Empty
#                                  pulls nothing. See internal/dvlibraries for the kinds.
# HEALTH_EXPORT_DIR=               a staged Apple Health export; empty leaves the extension off.
#
# ICLOUD_HEADED=1                  run the browser in a visible window instead of headless (debugging).
# ICLOUD_RESIDENT=external         never start the browser from the server: something else owns it
#                                  (the systemd install sets this in icloud-mcp-host).
# CHROMIUM_BIN=                    the Chrome or Chromium binary, when it is not found by itself.
#
# Multi-account installs can also move single paths out of ICLOUD_STATE: ICLOUD_SHARED_STATE,
# MAIL_ATTACHMENTS_DIR, DRIVE_STAGING, DRIVE_ETAGS, HEALTH_DB, plus ICLOUD_CDP (default
# http://127.0.0.1:9222) and AGENT_TZ_FILE (a file holding the zone, default /etc/agent/timezone,
# which wins over AGENT_TZ). See docs/SETUP.md.
