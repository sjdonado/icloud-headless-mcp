# Development-only Linux rehearsal for macOS hosts. This image runs the
# deterministic suites and the CDP mechanism smoke tests; it is NOT the
# deploy image and must never carry Apple credentials, session state, or
# the production sudoers rules.
#
# Build once from the repo root:
#   docker build -f Dockerfile.dev -t icloud-dev .
#
# Run with the repo mounted, shared memory for Chromium, and VNC on
# loopback only:
#   docker run --rm -it --shm-size=2g -e DISPLAY=:99 \
#     -v "$PWD:/work" -p 127.0.0.1:5900:5900 icloud-dev
#
# Inside:
#   go build ./... && go vet ./... && go test ./...
#   Xvfb :99 -screen 0 1280x900x24 &
#   chromium --remote-debugging-port=9222 about:blank &  # CDP smoke only
#
# What this does NOT cover: systemd units (no init here, run the
# ExecStart commands directly), Chromium RSS sizing (measure on the
# target box per docs/SETUP.md), and the real Apple grant/session
# lifecycle (needs real devices).
FROM golang:1-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    CHROME_PATH=/usr/bin/chromium

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    xvfb x11vnc \
    chromium \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Xvfb runs as the unprivileged user, so its socket directory must
# already exist and be world-writable.
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Dev-only convenience sudo. Production grants exactly one binary per rule
# (see sudoers.d/); this permissive line must never leave this file.
RUN useradd -m agent && \
    echo 'agent ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/agent-dev && \
    chmod 440 /etc/sudoers.d/agent-dev

USER agent
WORKDIR /work

CMD ["bash"]
